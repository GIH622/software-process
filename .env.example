# 示例！复制到本机自己的环境变量，不要在 GitHub 存放真正的密码。
# 全新开发库使用 library_dev，不要直接指向队友 library_db 后执行建表/种子！
DB_URL=jdbc:mysql://127.0.0.1:3306/library_dev?serverTimezone=Asia%2FShanghai&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=library_app
DB_PASSWORD=
LIBRARY_ADMIN_ACCOUNT=admin
LIBRARY_ADMIN_PASSWORD=
# 仅在 SPRING_PROFILES_ACTIVE=demo 并且连接 library_dev 时使用
LIBRARY_DEMO_READER_PASSWORD=
SERVER_PORT=8080
# 仅在经批准的变更验证库启用，运行20_CR001_renewal_optional.sql后才能开启。
LIBRARY_RENEWAL_ENABLED=false
# 共享库允许旧MD5验证、但禁止登录时静默改写已有密码值。
LIBRARY_LEGACY_MD5_LOGIN_ENABLED=true
LIBRARY_LEGACY_MD5_UPGRADE_ENABLED=false
